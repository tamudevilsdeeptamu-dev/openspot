rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Parking Space Images ──────────────────────────────────────────────
    // Only authenticated owners can upload; anyone signed in can read
    match /parking_spaces/{spaceId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024  // max 10 MB
        && request.resource.contentType.matches('image/.*');
    }

    // ── User Profile Images ───────────────────────────────────────────────
    match /users/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024   // max 5 MB
        && request.resource.contentType.matches('image/.*');
    }
  }
}
